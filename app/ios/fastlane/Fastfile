require "base64"
require "tmpdir"

default_platform(:ios)

platform :ios do
  # Expects `flutter build ios --release --config-only ...` to have run first: it writes
  # Generated.xcconfig (dart-defines, obfuscation, build name/number), which the Xcode
  # archive below picks up. See .github/workflows/release-ios.yml.
  #
  # Signing: manual, from a distribution certificate (.p12) and an App Store profile
  # passed as base64 env vars. CI-only: setup_ci creates a temporary keychain when CI=true.
  desc "Archive with manual signing and upload to TestFlight"
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8")
    )

    tmp = Dir.mktmpdir
    cert_path = File.join(tmp, "distribution.p12")
    profile_path = File.join(tmp, "appstore.mobileprovision")
    File.binwrite(cert_path, Base64.decode64(ENV.fetch("IOS_CERT_P12_BASE64")))
    File.binwrite(profile_path, Base64.decode64(ENV.fetch("IOS_PROFILE_BASE64")))

    import_certificate(
      certificate_path: cert_path,
      certificate_password: ENV.fetch("IOS_CERT_PASSWORD"),
      keychain_name: ENV.fetch("MATCH_KEYCHAIN_NAME"),
      keychain_password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD")
    )
    install_provisioning_profile(path: profile_path)

    profile_name = FastlaneCore::ProvisioningProfile.name(profile_path)
    team_id = FastlaneCore::ProvisioningProfile.parse(profile_path).fetch("TeamIdentifier").first
    app_id = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)

    # The project uses automatic signing for local development; switch only the
    # Release config of the Runner target to manual for this CI checkout.
    update_code_signing_settings(
      path: "Runner.xcodeproj",
      targets: ["Runner"],
      build_configurations: ["Release"],
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      export_options: { provisioningProfiles: { app_id => profile_name } },
      output_directory: "../build/ios/ipa"
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
