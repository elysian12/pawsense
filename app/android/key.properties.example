# Copy to android/key.properties (gitignored) to sign release builds locally.
# storeFile is resolved relative to android/app/. CI writes this file from
# ANDROID_KEYSTORE_BASE64 / ANDROID_KEYSTORE_PASSWORD / ANDROID_KEY_ALIAS / ANDROID_KEY_PASSWORD.
# Avoid backslashes in passwords: .properties treats them as escapes.
storeFile=upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
