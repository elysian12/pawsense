default_platform(:android)

platform :android do
  # The AAB is built (obfuscated, signed) by `flutter build appbundle` before this
  # lane runs; see .github/workflows/release-android.yml. Paths are relative to app/android.
  desc "Upload the release AAB to the Play internal testing track"
  lane :internal do
    upload_to_play_store(
      track: "internal",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      json_key_data: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON"),
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
